{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Processo_Dossie",
  "type": "object",
    "earqProcessoAnexo": { "type": "boolean" }, 
  "required": ["EarqProcessoId", "dc.date.issued", "earqProcessoMeio", "earqProcessoStatus", "earqProcessoVersao", "earqProcessoAutor", "earqClasseId", "earqNivelDeAcessoId", "earqProcessoIndicacaoAnotacao"  ],
  "properties": {
    "earqProcessoId": { "type": "string" },
    "dc.relation": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "EarqProcessoId": { "type": "string" },
          "EarqDocumentoId": { "type": "string" },
          "DcTitle": { "type": "string" }
        }
      }
    },
    "dc.date.issued": {"type": "string", "format": "date" },  
    "earqProcessoNumero": { "type": "string" },
    "earqProcessoProtocolo": { "type": "string" },
    "earqProcessoDossieId": { "type": "string" },
    "earqProcessoMeio": {
      "type": "string",
      "enum": ["digital", "não digital", "híbrido"]
    },
    "earqProcessoStatus": {
      "type": "string",
      "enum": ["tramitando", "sobrestado", "arquivado"]  # ver dominio
    },
    "earqProcessoAutor": {
      "type": "array",
      "description": "Lista de autores do processo.",
      "minItems": 1,
      "items": { "$ref": "agente_schema.json" }
    },

    "earqProcessoDestinatario": {
      "type": "array",
      "description": "Lista de destinatários do processo.",
      "items": { "$ref": "agente_schema.json" }
    },

    "earqProcessoInteressado": {
      "type": "array",
      "description": "Lista de interessados no processo.",
      "items": { "$ref": "agente_schema.json" }
    },    
    "earqProcessoOriginador": { "$ref": "agente_schema.json" }, 
    "earqProcessoRedator": {"$ref": "agente_schema.json"}, 
    "earqProcessoEspecie": { "type": "string" },
    "earqProcessoTipo": { "type": "string" },
    "dc.language": {
      "type": "string",
      "pattern": "^[a-z]{3}$" 
    },
    "earqProcessoQtFolha": { "type": "integer", "minimum": 1 },
    "earqProcessoAnexo": { "type": "boolean" },     
    "earqClasseId": {
      "type": "object",
      "properties": {
        "codigo": { "type": "string" },
        "descricao": { "type": "string" },
        "planoDeClassificacaoId": { "type": "string" }
      },
      "required": ["codigo"]
    },
    "earqProcessoDestinacao": {
      "type": "string",
      "enum": ["transferência", "eliminação", "recolhimento"]
    },
    "earqProcessoPrazoDeGuarda": { "type": "string", "format": "date" },
    "earqProcessoLocalizacao": {
      "type": "object",
      "properties": {
        "enderecoFisico": { "type": "string" },
        "siglaUnidade": { "type": "string" },
        "observacao": { "type": "string" }
      }
    },
    "earqNivelDeAcessoId": {"type": "string"}, 
    "earqProcessoIndicacaoAnotacao": { "type": "boolean" },
    "earqProcessoSetorExecucao": { "type": "string" },
    "earqVolumes": {
      "type": "array",
      "description": "Lista ordenada de volumes pertencentes ao processo, com numeração/ordem de apresentação.",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ordemVolume", "earqVolume"],
        "properties": {
          "ordemVolume": { "type": "integer", "minimum": 1 },
          "earqVolume": { "$ref": "volume_schema.json" }
        }
      }
    },
    "earqEventos": {
      "type": "array",
      "description": "Lista de eventos associados ao objeto ao longo de seu ciclo de vida (gestão, preservação, acesso, etc.).",
      "items": {
        "$ref": "evento_schema.json"
      }
    }
  } 
}
