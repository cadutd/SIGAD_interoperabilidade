{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Documento",
  "type": "object",    
  "required": ["EarqDocumentoId", "DcTitle", "dc.date.issued", "earqDocumentoMeio", "earqDocumentoStatus", "earqDocumentoVersao", "earqDocumentoAutor", "earqDocumentoDestinatario", "earqDocumentoRedator", "earqClasseId", "earqNivelDeAcessoId", "earqDocumentoIndicacaoAnotacao"  ],
  "properties": {
    "earqDocumentoId": { "type": "string" },
    "DcTitle": { "type": "string" },
    "DcDescription": { "type": "string" },
    "DcSubject": {
      "type": "array",
      "items": { "type": "string" }
    },
    "dc.relation": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "EarqDocumentoId": { "type": "string" },
          "EarqProcessoId": { "type": "string" },
          "DcTitle": { "type": "string" }
        }
      }
    },
    "dc.date.issued": {"type": "string", "format": "date" }, 
    "earqDocumentoNumero": { "type": "string" },
    "earqDocumentoProtocolo": { "type": "string" },
    "earqProcessoDossieId": { "type": "string" },
    "earqVolumeId": { "type": "string" },
    "earqDocumentoMeio": {
      "type": "string",
      "enum": ["digital", "não digital", "híbrido"]
    },
    "earqDocumentoStatus": {
      "type": "string",
      "enum": ["minuta", "original", "cópia", "versão autenticada", "conferida", "assinada digitalmente"]
    },
    "earqDocumentoVersao": { "type": "integer", "minimum": 1 },
    "earqDocumentoAutor": {
      "type": "array",
      "description": "Lista de autores do documento.",
      "minItems": 1,
      "items": { "$ref": "agente_schema.json" }
    },

    "earqDocumentoDestinatario": {
      "type": "array",
      "description": "Lista de destinatários do documento.",
      "items": { "$ref": "agente_schema.json" }
    },

    "earqDocumentoInteressado": {
      "type": "array",
      "description": "Lista de interessados no documento.",
      "items": { "$ref": "agente_schema.json" }
    },
    "earqDocumentoOriginador": { "$ref": "agente_schema.json" }, 
    "earqDocumentoRedator": {"$ref": "agente_schema.json"}, 

    "earqDocumentoGenero": {
      "type": "string",
      "enum": ["textual", "audiovisual", "cartográfico", "iconográfico", "multimídia", "micrográfico", "sonoro", "tridimensional"] 
    }, # precisa atualizar o dominio do genero, principalmente para acertar a confusão quanto aos generos inexistentes digital e eletronico
    "earqDocumentoEspecie": { "type": "string" },
    "earqDocumentoTipo": { "type": "string" },
    "dc.language": {
      "type": "string",
      "pattern": "^[a-z]{3}$" 
    },
    "earqDocumentoQtFolha": { "type": "integer", "minimum": 1 },    
    "earqDocumentoAnexo": { "type": "boolean" },     
    "earqClasseId": {
      "type": "object",
      "properties": {
        "codigo": { "type": "string" },
        "descricao": { "type": "string" },
        "planoDeClassificacaoId": { "type": "string" }
      },
      "required": ["codigo"]
    },
    "earqDocumentoDestinacao": {
      "type": "string",
      "enum": ["transferência", "eliminação", "recolhimento"]
    },
    "earqDocumentoPrazoDeGuarda": { "type": "string", "format": "date" }, 
    "earqDocumentoLocalizacao": {
      "type": "object",
      "properties": {
        "enderecoFisico": { "type": "string" },
        "siglaUnidade": { "type": "string" },
        "observacao": { "type": "string" }
      }
    },    
    "earqNivelDeAcessoId": {
      "type": "string",
      "default": "ostensivo",
      "description": "Nível de acesso do documento. Valor padrão: ostensivo."
    },
    "earqDocumentoIndicacaoAnotacao": { "type": "boolean" },
    "earqDocumentoSetorExecucao": { "type": "string" },
    "earqComponentes": {
      "type": "array",
      "items": { "$ref": "componente_schema.json" }
    },
    "earqEventos": {
      "type": "array",
      "description": "Lista de eventos associados ao objeto ao longo de seu ciclo de vida (gestão, preservação, acesso, etc.).",
      "items": {
        "$ref": "evento_schema.json"
      }
    }
  } 
}
