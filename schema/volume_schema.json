{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Volume",
  "type": "object",
  "required": ["earqVolumeId", "earqVolumeNumero","earqDataAbertura"],
  "properties": {    
    "earqVolumeId": { "type": "string" },
    "earqVolumeNumero": { "type": "string" },
    "earqVolumeQtFolha": { "type": "integer", "minimum": 1 },    
    "earqDataAbertura": {"type": "string", "format": "date"},
    "earqDataEncerramento": {"type": "string", "format": "date"},
    "earqVolumeLocalizacao": { "$ref": "localizacao_schema.json" },
    "earqDocumentos": {
      "type": "array",
      "description": "Lista ordenada de documentos pertencentes ao volume, com ordem de apresentação.",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ordemApresentacao", "earqDocumentoId"],
        "properties": {
          "ordemApresentacao": { "type": "integer", "minimum": 1 },
          "earqDocumentoId": { "type": "string" }
        }
      }
    }    
  }
}