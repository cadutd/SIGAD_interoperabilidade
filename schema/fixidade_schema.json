{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fixidade",
  "type": "object",
  "properties": {
    "algoritmo": {
      "type": "string",
      "enum": ["MD5", "SHA-1", "SHA-256", "SHA-512", "OUTRO"]
    },
    "hash": {
      "type": "string",
      "minLength": 1
    },
    "originador": {
      "type": "string"
    }

  },
  "required": [
    "algoritmo",
    "hash"
  ]
}