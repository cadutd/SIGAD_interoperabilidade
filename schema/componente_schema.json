{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Componente",
  "type": "object",
  "required": ["EarqComponenteId", "EarqComponenteNomeOriginal", "earqComponenteTamanho","earqComponenteUnidadeMedidaTamanho","earqComponenteDataCriacao", "earqComponenteLocalizacao", "earqComponenteFixidade"],
  "properties": {
    "earqComponenteId": { "type": "string" },
    "earqComponenteNomeOriginal": { "type": "string" },
    "earqComponenteTamanho": { "type": "integer", "minimum": 0 },
    "earqComponenteUnidadeMedidaTamanho": {
      "type": "string",
      "enum": ["KB", "MB", "GB", "TB"]
    },
    "earqComponenteSoftwareCriacao": {
      "$ref": "software_schema.json"
    },
    "earqComponenteDataCriacao": { "type": "string", "format": "date" },
    "earqComponenteNivelComposicao": {
      "type": "integer",
      "enum": [0, 1]
    },
    "earqComponenteInibidor": {
      "$ref": "inibidor_schema.json"
    },
    "earqComponenteFormato": {
      "$ref": "formato_schema.json"
    },
    "earqComponenteLocalizacao": {
      "$ref": "localizacao_schema.json"
    },
    "earqComponenteSuporte": {
      "type": "string",
      "enum": [
        "FITA_MAGNETICA",
        "HD",
        "SSD",
        "CARTAO_MEMORIA",
        "DISCO_OPTICO",
        "NAOIDENTIFICADO"
      ]
    },
    "earqComponenteSoftwareLeitura": {
      "$ref": "software_schema.json"
    },
    "earqComponenteHardware": {
      "$ref": "hardware_schema.json"
    },
    "earqComponenteOutrasDependencias": {
      "type": "array",
      "items": { "$ref": "dependencia_schema.json" }
    },
    "earqComponenteRelacionamentos": {
      "type": "array",
      "items": { "$ref": "relacionamento_schema.json" }
    },
    "earqComponenteFixidade": {
      "$ref": "fixidade_schema.json"
    },
    "earqComponenteAssinaturas": {
      "type": "array",
      "items": { "$ref": "assinatura_schema.json" }
    }, # Pedro ficou de convidar um profissional especialista para faze esse schema de assinatura
    "earqEventos": {
      "type": "array",
      "description": "Lista de eventos associados ao objeto ao longo de seu ciclo de vida (gestão, preservação, acesso, etc.).",
      "items": {
        "$ref": "evento_schema.json"
      }
    }    
  }
}