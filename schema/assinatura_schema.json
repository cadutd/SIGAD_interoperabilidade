{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Assinatura",
  "type": "object",
  "required": ["signatario", "tipoAssinatura", "dataHoraAssinatura"],
  "properties": {
    "signatario": {
      "$ref": "agente_schema.json"
    },
    "dataHoraAssinatura": {
      "type": "string",
      "format": "date-time"
    },        
    "tipoAssinatura": {
      "type": "string",
      "description": "Tipo de assinatura conforme Lei 14.063/2020",
      "enum": [
        "SIMPLES",
        "AVANCADA",
        "QUALIFICADA"
      ]
    },
    "assinaturaUsuarioSenha": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identificadorUsuario": {
          "type": "string",
          "description": "identificador unico usando pelo sistema de autenticação para identificar o usuário"
        },
        "sistemaAutenticacao": {
          "type": "string",
          "description": "Sistema informatizado que conhecia a indentidade do usuário e que fez a autenticação no momento da assinatura. Ex.: SEI, LDAP, AD, KEYCLOACK"
        },
        "fatorAutenticacao": {
          "type": "string",
          "enum": ["senha", "senha_hash", "sessao_autenticada", "outro"]
        },
        "checksumConteudo": {
          "$ref": "fixidade_schema.json"
        }
      },
      "required": ["identificadorUsuario", "sistemaAutenticacao","checksumConteudo"]
    },
    "assinaturaCertificadoDigital": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tipoPadrao": {
          "type": "string",
          "enum": ["PKCS#7", "CMS", "CAdES", "PAdES", "XAdES", "XMLDSig", "OUTRO"]
        },
        "formatoAssinatura": {
          "type": "string",
          "enum": ["EMBUTIDA", "DESTACADA"]
        },
        "earqComponenteIdDestacado": {
          "type": "string",
          "description": "identificador que representa o componente do arquivo de assinatura destacada"
        },
        "referenciaValidacao": {
          "type": "string",
          "description": "referencia para a validação da assinatura. LCR - Lista de Certificados Revogados, RESPOSTA OCSP ou outro forma.",
          "enum": ["LCR","OCSP","OUTRO"]
        }
      }  
    }    

  },
    "oneOf": [
    {
      "required": [
        "assinaturaUsuarioSenha"
      ]
    },
    {
      "required": [
        "assinaturaCertificadoDigital"
      ]
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "assinaturaCertificadoDigital": {
            "type": "object",
            "properties": {
              "formatoAssinatura": {
                "const": "DESTACADA"
              }
            },
            "required": [
              "formatoAssinatura"
            ]
          }
        },
        "required": [
          "assinaturaCertificadoDigital"
        ]
      },
      "then": {
        "properties": {
          "assinaturaCertificadoDigital": {
            "required": [
              "earqComponenteIdDestacado"
            ]
          }
        }
      }
    }
  ]  
}